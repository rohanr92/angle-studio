# Freepik API credentials — https://freepik.com/api
# Get / rotate your key at: https://www.freepik.com/developers/dashboard
FREEPIK_API_KEY=your_freepik_api_key_here

# Optional — only used if you later wire up a public webhook receiver
# (via ngrok/cloudflared) instead of the built-in polling flow.
FREEPIK_WEBHOOK_SECRET=your_webhook_secret_here

# Port the local server runs on
PORT=5050
